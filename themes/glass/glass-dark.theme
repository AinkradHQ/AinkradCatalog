{
  "schemaVersion": 1,
  "id": "glass.dark",
  "name": "macOS Glass",
  "base": "neonBlue",
  "material": {
    "kind": "glass",
    "panelOpacity": 0.3
  },
  "shape": {
    "style": "continuous",
    "corners": "all"
  },
  "type": {
    "labelCase": "none"
  },
  "cut": {
    "c2": 4,
    "c3": 5,
    "c4": 6,
    "c5": 6,
    "c6": 8,
    "c7": 8,
    "c8": 10,
    "c20": 20,
    "c22": 22,
    "r0_10": 0.16,
    "r0_2": 0.22,
    "r0_22": 0.225
  },
  "effects": {
    "brackets": {
      "stroke": "clear",
      "glow": "clear",
      "width": 0,
      "glowRadius": 0
    },
    "glowBloom": {
      "color": "clear",
      "reducedOpacityColor": "clear"
    },
    "panelGlow": [],
    "scanline": {
      "staticOpacity": 0,
      "movingOpacity": 0
    },
    "hexGrid": {
      "opacity": 0,
      "reducedOpacity": 0
    },
    "edgeRing": {
      "from": "foreground@0.1",
      "to": "foreground@0.04"
    }
  },
  "chrome": {
    "overlay": {
      "edgeFrom": "foreground@0.1",
      "edgeTo": "foreground@0.04"
    }
  },
  "elevation": {
    "level1": {
      "color": "black@0.18",
      "radius": 6,
      "x": 0,
      "y": 2
    },
    "level2": {
      "color": "black@0.28",
      "radius": 18,
      "x": 0,
      "y": 8
    }
  },
  "components": {
    "button": {
      "glow": {
        "color": {
          "hover": "clear",
          "rest": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      },
      "labelFont": {
        "tracking": 0
      }
    },
    "checkbox": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "chip": {
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "combobox": {
      "glow": {
        "color": {
          "focused": "clear",
          "rest": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "groupedSelectTrigger": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "iconButton": {
      "glow": {
        "color": {
          "hover": "clear",
          "rest": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "iconGlyph": {
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "multiSelectCheck": {
      "stroke": {
        "color": "foreground@0.1"
      }
    },
    "multiSelectTrigger": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "radioGroup": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "markerShape": "Circle"
    },
    "segmentedPicker": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "selectTrigger": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "signalFeedRow": {
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      },
      "metaFont": {
        "tracking": 0
      }
    },
    "signalToast": {
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      },
      "failureStrokeColor": "foreground@0.1"
    },
    "stepper": {
      "stroke": {
        "color": "foreground@0.1"
      }
    },
    "swatchChip": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1",
          "hover": "foreground@0.18"
        }
      }
    },
    "textArea": {
      "glow": {
        "color": {
          "focused": "clear",
          "rest": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      }
    },
    "toast": {
      "glow": {
        "color": "clear"
      },
      "stroke": {
        "color": "foreground@0.1"
      }
    },
    "toggle": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "toggleButton": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      },
      "labelFont": {
        "tracking": 0
      }
    },
    "railItem": {
      "glow": {
        "color": {
          "hover": "clear",
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "hover": "foreground@0.18",
          "rest": "foreground@0.1"
        }
      }
    },
    "commandMenuRow": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      },
      "stroke": {
        "color": {
          "rest": "foreground@0.1"
        }
      },
      "titleFont": {
        "tracking": 0
      }
    },
    "statusBar": {
      "glow": {
        "color": {
          "rest": "clear",
          "selected": "clear"
        }
      }
    },
    "spinner": {
      "glow": {
        "color": "clear"
      }
    },
    "confirmDialog": {
      "titleFont": {
        "tracking": 0
      }
    },
    "sectionHeader": {
      "tickWidth": 0,
      "titleFont": {
        "tracking": 0
      }
    },
    "formRow": {
      "tickWidth": 0,
      "tickColor": "clear"
    },
    "tabs": {
      "tickHeight": 0,
      "labelFont": {
        "tracking": 0
      }
    },
    "sectionFrame": {
      "tickWidth": 0,
      "titleFont": {
        "tracking": 0
      }
    },
    "badge": {
      "font": {
        "tracking": 0
      }
    },
    "breadcrumb": {
      "activeFont": {
        "tracking": 0
      },
      "font": {
        "tracking": 0
      }
    },
    "codeBlock": {
      "headerFont": {
        "tracking": 0
      }
    },
    "dataTable": {
      "headerFont": {
        "tracking": 0
      }
    },
    "disclosureGroup": {
      "titleFont": {
        "tracking": 0
      }
    },
    "meter": {
      "labelFont": {
        "tracking": 0
      }
    },
    "signalFeedList": {
      "dayHeaderFont": {
        "tracking": 0
      }
    },
    "statRow": {
      "labelFont": {
        "tracking": 0
      }
    }
  },
  "host": {
    "language": {
      "id": "glass",
      "name": "macOS Glass",
      "appearance": "dark",
      "defaultColorScheme": "glassDark",
      "fontFamily": "system",
      "layout": "islands",
      "sky": true,
      "islandArt": true,
      "paneBackdrop": "sky",
      "appTile": "plain"
    }
  }
}
